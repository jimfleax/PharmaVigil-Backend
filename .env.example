# ==============================================================================
# PharmaVigil (Medication Safety Platform) - Backend Environment Configuration
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=8787

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ventureforge_medication_safety

# CORS Allowlist (comma-separated or single exact origin, credentials enabled)
APP_ORIGIN_ALLOWLIST=http://localhost:3000

# Session Configuration
SESSION_COOKIE_NAME=__Host-vf_session
SESSION_SECRET=replace_with_a_secure_random_64_char_secret_in_production
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=8

# CSRF & Security
CSRF_SECRET=replace_with_a_secure_random_64_char_secret_for_csrf

# Demo Workspace & Scoped Reset
DEMO_WORKSPACE_ID=synthetic-demo-hospital
DEMO_RESET_ENABLED=false

# Logging Level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info
